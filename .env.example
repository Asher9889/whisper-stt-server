# Whisper model settings
WHISPER_MODEL=turbo
# WHISPER_MODEL_DIR=/path/to/models
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0.0
WHISPER_VAD_FILTER=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_LANGUAGE=hi

# Audio
WHISPER_TARGET_SAMPLE_RATE=16000
WHISPER_MIN_UTTERANCE_MS=40
# WHISPER_AUDIO_DUMP_DIR=/tmp/stt-dumps

# Concurrency
WHISPER_QUEUE_MAXSIZE=32

# URL transcription API (POST /v1/transcriptions)
# Leave STT_API_TOKEN empty to disable bearer auth (dev only).
# STT_API_TOKEN=change-me
STT_DOWNLOAD_TIMEOUT_S=120
STT_MAX_DOWNLOAD_MB=100

# Server
STT_HOST=0.0.0.0
STT_PORT=8000
LOG_LEVEL=INFO
