# Whisper model settings
WHISPER_MODEL=large-v3
# WHISPER_MODEL_DIR=/path/to/models
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_TEMPERATURE=0.0
WHISPER_VAD_FILTER=false
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_LANGUAGE=hi

# Hallucination guarding (segment-level filters; PCM path keeps vad_filter=false)
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
# Peak signal level below which audio is treated as silence (skip inference)
WHISPER_SILENCE_LEVEL=0.0001

# Audio
WHISPER_TARGET_SAMPLE_RATE=16000
WHISPER_MIN_UTTERANCE_MS=40
# WHISPER_AUDIO_DUMP_DIR=/tmp/stt-dumps

# Concurrency
WHISPER_QUEUE_MAXSIZE=32

# URL transcription API (POST /v1/transcriptions)
# Leave STT_API_TOKEN empty to disable bearer auth (dev only).
# STT_API_TOKEN=change-me
STT_DOWNLOAD_TIMEOUT_S=120
STT_MAX_DOWNLOAD_MB=100

# Server
STT_HOST=0.0.0.0
STT_PORT=8000
LOG_LEVEL=INFO
